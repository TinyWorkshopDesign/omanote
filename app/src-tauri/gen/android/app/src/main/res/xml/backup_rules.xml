<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and lower (allowBackup="false" already turns backups off there; this is
     the fallback should it ever be switched on): exclude everything. -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
